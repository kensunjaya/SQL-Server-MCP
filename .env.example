DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=AppDb
DB_USER=mcp_user
DB_PASSWORD=replace_me
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=30000
DB_MAX_ROWS=500
DB_MAX_SQL_LENGTH=100000
DB_MAX_TRANSACTION_STEPS=20
DB_ALLOW_WRITE=true
DB_ALLOW_DELETE=false
DB_ALLOW_DDL=false
DB_ALLOW_PROCEDURES=true
DB_ALLOW_TRANSACTIONS=true
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_PATH=/mcp
# Comma-separated public hostnames accepted behind a reverse proxy or Cloudflare Tunnel.
MCP_HTTP_ALLOWED_HOSTS=

# HTTP authentication: none (local only), bearer, cloudflare, or hybrid (recommended remotely).
MCP_AUTH_MODE=hybrid

# Static token used by Codex CLI and developer clients in bearer/hybrid mode.
# Generate a long random value and never commit the real token.
MCP_AUTH_TOKEN=replace_with_a_long_random_secret

# Cloudflare Zero Trust team domain and this Access application's Audience (AUD) tag.
# Required in cloudflare/hybrid mode. The team domain must be HTTPS and end in
# .cloudflareaccess.com. Replace both example values before using HTTP mode.
CF_ACCESS_TEAM_DOMAIN=https://example.cloudflareaccess.com
CF_ACCESS_AUD=replace_with_the_access_application_aud

LOG_LEVEL=info
